    {
      "name": "4. Pendientes",
      "item": [
        {
          "name": "13 Consultar pendientes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Solo aparece la solicitud no atendida\", () => {",
                  "  const lista = pm.response.json();",
                  "  pm.expect(lista.length).to.eql(1);",
                  "  pm.expect(lista[0].id).to.eql(Number(pm.collectionVariables.get(\"id2\")));",
                  "  pm.expect(lista[0].estado).to.eql(\"PENDIENTE\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/solicitudes/pendientes",
              "host": [
