{
  "info": {
    "name": "Taller 2 - Gestión de solicitudes de recursos",
    "description": "Pruebas de las operaciones del tier de negocio (EJB) a través de los endpoints REST. Ejecutar en orden con el Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/negocio-jee/rest"
    }
  ],
  "item": [
    {
      "name": "1. Registrar",
      "item": [
        {
          "name": "01 Registrar solicitud válida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Inicia en estado PENDIENTE\", () => pm.expect(pm.response.json().estado).to.eql(\"PENDIENTE\"));",
                  "pm.test(\"Recibe un id asignado por el sistema\", () => pm.expect(pm.response.json().id).to.be.a(\"number\"));",
                  "pm.collectionVariables.set(\"id1\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/solicitudes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "solicitudes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcionDesastre\": \"Inundación en el barrio La Esperanza\",\n  \"tipoRecurso\": \"Agua potable\",\n  \"cantidad\": 500,\n  \"prioridad\": \"ALTA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "02 Registrar segunda solicitud",
          "event": [
