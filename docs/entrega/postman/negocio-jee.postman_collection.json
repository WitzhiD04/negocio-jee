    {
      "name": "2. Consultar",
      "item": [
        {
          "name": "07 Consultar todas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve las 2 solicitudes válidas (las rechazadas no se guardaron)\", () => pm.expect(pm.response.json().length).to.eql(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/solicitudes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "solicitudes"
              ]
            }
          }
        },
        {
          "name": "08 Buscar por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve la solicitud pedida\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"id1\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/solicitudes/{{id1}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "solicitudes",
                "{{id1}}"
              ]
            }
          }
        },
        {
          "name": "09 Buscar id inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde HTTP 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Mensaje: No existe una solicitud con id 999\", () => pm.expect(pm.response.json().error).to.eql(\"No existe una solicitud con id 999\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
